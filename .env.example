# Copy to .env for local development. Never put real values in this file or commit .env.
# Public Supabase URL and publishable key are designed for browser use, but database access
# must still be protected with correct Row Level Security (RLS) policies.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_ID=

# Server-only AI provider credentials. Do not prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# If a future server-only database connection is needed, store its credential in the
# deployment provider's secret manager only. Never put service-role keys in client code.
